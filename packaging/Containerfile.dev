# The development container for atlas-framework: Atlas.Ui, the gallery, the
# template and the Rust crates build and run headless in it. The host has no
# Qt development packages.
#
#   podman build -t localhost/atlas-framework-dev:44 -f packaging/Containerfile.dev packaging
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y -q --setopt=install_weak_deps=False install \
        cmake ninja-build ccache gcc-c++ git-core rpm-build desktop-file-utils libappstream-glib \
        qt6-qtbase-devel qt6-qttools-devel qt6-linguist qt6-qtbase-private-devel qt6-qtbase-gui qt6-qtdeclarative-devel \
        kf6-kirigami-devel kf6-kconfig-devel kf6-kwindowsystem-devel kf6-kdbusaddons-devel \
        kf6-qqc2-desktop-style plasma-breeze breeze-icon-theme google-noto-sans-fonts ibm-plex-sans-fonts jetbrains-mono-fonts \
        cargo corrosion clippy rustfmt lld flatpak-devel glib2-devel \
        xorg-x11-server-Xvfb xdotool xwd ImageMagick dbus-daemon \
        jq procps-ng diffutils which openssl-devel \
    && dnf clean all
# cargo-semver-checks (CI: the crates' public items against the last release).
# Installed outside /root so any user running the container can call it.
ENV CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN cargo install cargo-semver-checks --version 0.51.0 --locked && rm -rf /opt/cargo/registry /opt/cargo/git
