# High-contrast colour scheme for the visual tests: black windows, white text,
# yellow focus and selection. Written for this repository (MIT), in the format
# of KDE's colour schemes; it follows the idea of Breeze High Contrast.

[ColorEffects:Disabled]
Color=0,0,0
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=-0.4
IntensityEffect=1

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

